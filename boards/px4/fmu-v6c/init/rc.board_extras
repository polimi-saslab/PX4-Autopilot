#!/bin/sh
# Start the external airflow probe after the main sensor and vehicle setup.
if ! param greater SYS_HITL 0
then
	if param compare -s SENS_EN_SOLANO 1
	then
		echo "Solano enabled: starting on I2C2 at 0x7A"
		if ! solano start -X -b 2 -a 0x7A
		then
			echo "Solano startup failed: retrying in 2 seconds"
			sleep 2
			if ! solano start -X -b 2 -a 0x7A
			then
				echo "Solano automatic startup failed. Check dmesg."
			fi
		fi
	fi
fi
